    {
      "type": "text", "id": "code_text",
      "x": 555, "y": 112, "width": 400, "height": 235,
      "text": "# compile 时设置中断点\napp = graph.compile(\n    interrupt_before=[\"conduct_interview\"]\n)\n\n# 第1次调用 → 执行到中断点暂停\nresult = app.invoke({\"topic\": \"AI趋势\"})\n\n# 人工审查 State\nprint(result[\"search_queries\"])\nresult[\"sources\"] = modified_sources  # 可修改\n\n# 第2次调用 → 从中断点恢复\nresult = app.invoke(None, config)", "originalText": "# compile 时设置中断点\napp = graph.compile(\n    interrupt_before=[\"conduct_interview\"]\n)\n\n# 第1次调用 → 执行到中断点暂停\nresult = app.invoke({\"topic\": \"AI趋势\"})\n\n# 人工审查 State\nprint(result[\"search_queries\"])\nresult[\"sources\"] = modified_sources  # 可修改\n\n# 第2次调用 → 从中断点恢复\nresult = app.invoke(None, config)",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
