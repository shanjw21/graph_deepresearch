    {
      "type": "text", "id": "code_text",
      "x": 555, "y": 112, "width": 390, "height": 195,
      "text": "# 三步构建模式\ngraph = StateGraph(ResearchState)\n\n# ① 添加节点\ngraph.add_node(\"generate_queries\", fn)\ngraph.add_node(\"web_search\", fn)\n\n# ② 添加边\ngraph.add_edge(START, \"generate_queries\")\ngraph.add_conditional_edges(\"grade_sources\", route)\n\n# ③ 编译\napp = graph.compile()", "originalText": "# 三步构建模式\ngraph = StateGraph(ResearchState)\n\n# ① 添加节点\ngraph.add_node(\"generate_queries\", fn)\ngraph.add_node(\"web_search\", fn)\n\n# ② 添加边\ngraph.add_edge(START, \"generate_queries\")\ngraph.add_conditional_edges(\"grade_sources\", route)\n\n# ③ 编译\napp = graph.compile()",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 201111, "version": 1, "versionNonce": 201112,
      "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": "code_rect", "lineHeight": 1.25
    },
